# ── 前端接口地址 ───────────────────────────────────────────────
# 留空（推荐）= 同源请求 /api：
#   开发：由 vite.config.js 的 proxy 转发到 VITE_DEV_API_PROXY_TARGET
#   生产：由 Nginx 等反向代理把 /api 转发到后端（前端无需改动）
# 只有前后端真正跨域部署（前端域名 ≠ 后端域名）时才显式填写后端地址，
# 例如 VITE_API_BASE_URL=https://api.example.com，并在后端设置 APP_CORS_ALLOWED_ORIGINS。
VITE_API_BASE_URL=

# ── 开发服务器（npm run dev / npm run preview）──────────────────
# 监听地址与端口
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
# 端口被占用时是否直接失败。设 false 会静默顺延到 5174，
# 若后端仍按 5173 配了 CORS，就会变成「无法连接服务器」，所以默认 true。
VITE_DEV_STRICT_PORT=true
# /api 的代理目标；置空则关闭代理（此时需要用 VITE_API_BASE_URL 指向后端）
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# npm run preview 的端口
VITE_PREVIEW_PORT=4173
